{
  "name": "dsh-bili-jingjing",
  "version": "0.2.2",
  "description": "DSH 插件：每天替你刷一轮 B站 —— 读字幕挑出值得的、写一份日报；可以 @ 你，也可以跟你私信聊天",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "mcp",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "vendor",
    "README.md",
    "AGENTS.md",
    "selfcheck.mjs",
    "LICENSE",
    "NOTICE.md",
    "CONTRIBUTORS.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
